# ============================================
# E-Voting OSIS - Environment Variables
# Salin file ini menjadi .env.local
# ============================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/osis-voting
# Contoh Atlas: mongodb+srv://user:password@cluster.mongodb.net/osis-voting

# NextAuth
NEXTAUTH_SECRET=ganti-dengan-string-random-32-karakter-atau-lebih
NEXTAUTH_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# App Settings (opsional)
NEXT_PUBLIC_APP_NAME="E-Voting OSIS"
NEXT_PUBLIC_SCHOOL_NAME="SMA Negeri 1 Contoh"
NEXT_PUBLIC_YEAR="2024/2025"
